{
  "expo": {
    "name": "잇다",
    "slug": "itda",
    "scheme": "itda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "store.idta.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "음성·영상 통화에서 상대방과 대화하기 위해 마이크를 사용합니다.",
        "NSCameraUsageDescription": "영상 통화에서 내 모습을 보여주기 위해 카메라를 사용합니다.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "store.idta.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FE6A4C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필·서비스 사진과 채팅에 보낼 사진을 고르기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "영상 통화와 사진 촬영을 위해 카메라를 사용합니다.",
          "microphonePermission": "음성·영상 통화에서 상대방과 대화하기 위해 마이크를 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Pretendard-Regular.otf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Medium.otf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Pretendard-SemiBold.otf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Bold.otf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Pretendard-ExtraBold.otf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Pretendard-Regular.otf",
              "./assets/fonts/Pretendard-Medium.otf",
              "./assets/fonts/Pretendard-SemiBold.otf",
              "./assets/fonts/Pretendard-Bold.otf",
              "./assets/fonts/Pretendard-ExtraBold.otf"
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
