# 앱 빌드 때 번들에 그대로 들어간다(EXPO_PUBLIC_*). 비밀 키는 넣지 않는다.
EXPO_PUBLIC_API_URL=https://api.idta.store
# 토스페이먼츠 결제창 연동 클라이언트 키 (test_ck_… / live_ck_…)
EXPO_PUBLIC_TOSS_CLIENT_KEY=TOSS_CLIENT_KEY
# 블록체인 노드 REST 주소
EXPO_PUBLIC_CHAIN_REST_URL=https://blockchain.idta.store
# 피어 수(/net_info) 조회용 CometBFT RPC 주소. 설정하지 않으면 '운용 노드'는 '-'로 표시된다.
# EXPO_PUBLIC_CHAIN_RPC_URL=https://rpc.idta.store
# NewBlock 구독용 CometBFT 웹소켓. 설정하지 않으면 REST 폴링으로 동작한다.
# EXPO_PUBLIC_CHAIN_RPC_WS=wss://rpc.idta.store/websocket
